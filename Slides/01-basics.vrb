\frametitle{Computing $\hat \beta _{2004}$ on \texttt {castle.dta} --- by hand vs.\ OLS}
\vspace{0.1em}
\footnotesize Castle doctrine cohort treated in 2006. Use 2005 as the omitted reference. The 2004 coefficient is one event-study 2$\times$2.
\vspace{0.3em}
\begin{columns}[T,onlytextwidth]
\column{0.50\textwidth}
\textbf{By hand}
\begin{lstlisting}[basicstyle=\ttfamily\tiny]
su l_homicide if treat==1 & year==2004
* mean = 1.802504
su l_homicide if treat==1 & year==2005
* mean = 1.775398
su l_homicide if treat==0 & year==2004
* mean = 1.254353
su l_homicide if treat==0 & year==2005
* mean = 1.282884

di (1.802504 - 1.775398) ///
 - (1.254353 - 1.282884)
\end{lstlisting}
\begin{center}
\footnotesize $\hat\beta_{2004} =$ \highlight{$\mathbf{0.0556}$}
\end{center}
\column{0.50\textwidth}
\textbf{Via OLS in Stata}
\begin{lstlisting}[basicstyle=\ttfamily\tiny]
reg l_homicide ///
   treat##ib2005.year, ///
   cluster(state)

* Coefficient on
*   1.treat#2004.year:
\end{lstlisting}
\begin{center}
\footnotesize $\hat\beta_{2004} =$ \highlight{$\mathbf{0.05564}$}
\end{center}
\meta{Cluster-robust SE: 0.060. \;Match to 4 decimals.}
\end{columns}
\vspace{0.3em}
\begin{center}
\footnotesize\color{warmgray}\itshape
Every event-study coefficient is a 2$\times$2 \textit{relative to $t = -1$} (here, 2005).
\end{center}
